# Copia a .env local (ignorado por Git). Nunca uses variables VITE_ para claves.
# La web no requiere que los visitantes inicien sesión con ChatGPT ni Google.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Opcional: proveedor OpenAI-compatible alojado.
# AI_PROVIDER=openai_compatible
# AI_MODEL=nombre-del-modelo
# AI_BASE_URL=https://tu-proveedor.example/v1
# AI_API_KEY=

# Opcional: modelo local ya instalado en Ollama.
# AI_PROVIDER=ollama
# AI_MODEL=nombre-del-modelo
# AI_BASE_URL=http://127.0.0.1:11434
